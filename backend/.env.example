# 运行端口与前端地址
# 本地开发：前端跑在 5173，接口经 Vite 代理，回调用前端源
# 生产：docker compose 会把 WEB_APP_URL/CORS_ORIGINS 覆盖为公网地址
PORT=3000
WEB_APP_URL=http://localhost:5173
# 允许带凭证的来源（逗号分隔，支持 `*` 通配，如 https://*.vercel.app）
CORS_ORIGINS=http://localhost:5173

# Postgres：本地用 docker compose up -d 起库；容器内由 compose 覆盖为 postgres:5432
DATABASE_URL=postgresql://knowyou:knowyou@localhost:5432/knowyou?schema=public

# 若接口必须走本机代理（Node fetch 不自动读系统代理）：
#   NODE_USE_ENV_PROXY=1 npm run start:dev （配合 HTTPS_PROXY / ALL_PROXY）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# 知乎 OAuth：App ID / App Key 由黑客松赛事页面分配
# APP_KEY 只在服务端换取 token 时使用，不进源码、URL、日志与前端响应
# REDIRECT_URI 必须与赛事页面登记值逐字符一致（协议、域名、端口、路径、尾斜杠）
ZHIHU_OAUTH_APP_ID=replace-with-your-app-id
ZHIHU_OAUTH_APP_KEY=replace-with-your-app-key
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
