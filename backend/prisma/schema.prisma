generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起连接串移到 prisma.config.ts 的 datasource.url
datasource db {
  provider = "postgresql"
}

enum RoomState {
  waiting
  playing
  finished
}

enum AiStatus {
  idle
  pending
  error
}

enum PlayerRole {
  a
  b
}

model Room {
  code String @id

  state        RoomState @default(waiting)
  round        Int       @default(0)
  narration    String    @default("")
  scene        String    @default("")
  isEnding     Boolean   @default(false)
  endingReason String    @default("")
  aiStatus     AiStatus  @default(idle)
  aiError      String    @default("")

  // 本局绑定的剧本大纲快照，开局时写入，保证一局内不随种子缓存变化
  outline Json?

  // AI 生成的当前可选分支与本回合未结算的提交，结构由 lib/room-store.ts 的 Choice / Submission 决定
  choices     Json @default("[]")
  submissions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players Player[]
  turns   Turn[]
  report  Report?
}

model Seed {
  // 知乎内容 work_id 是 int64，全程以 TEXT 存储与传递
  workId String @id

  title        String   @default("")
  labels       String[]
  description  String   @default("")
  artwork      String   @default("")
  authorName   String   @default("")
  authorAvatar String   @default("")
  introduction String   @default("")
  content      String   @default("")
  // 由正文提炼的双人剧本大纲，缺省表示尚未提炼
  outline Json?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
}

model User {
  id String @id @default(cuid())

  // 知乎 uid 是 int64，可能超过 JS 安全整数范围，全程以 TEXT 存储与传递
  zhihuUid String @unique
  hashId   String @default("")
  fullname String @default("")
  avatar   String @default("")
  headline String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model Session {
  // 存放会话令牌的 SHA-256，Cookie 里才是原值：数据库泄露不足以直接伪造会话
  tokenHash String @id
  userId    String

  // OAuth token 只留服务端，不下发浏览器
  oauthAccessToken   String
  oauthTokenExpires  DateTime
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OauthState {
  // 一次登录请求的 CSRF 关联值，回调时原子消费，防重放
  state     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Player {
  id       String     @id
  roomCode String
  name     String
  role     PlayerRole
  // 座位号保持 Room.playerIds 的加入顺序，回合结算依赖这个顺序
  seat     Int

  room Room @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@unique([roomCode, seat])
  @@index([roomCode])
}

model Turn {
  id        String @id @default(cuid())
  roomCode  String
  round     Int
  // 本回合双方的提交快照，结构由 lib/room-store.ts 的 StoryEntry 决定
  entries   Json
  narration String

  room Room @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@unique([roomCode, round])
}

model Report {
  roomCode    String   @id
  common      String[]
  differences String[]
  complement  String
  topics      String[]

  room Room @relation(fields: [roomCode], references: [code], onDelete: Cascade)
}
