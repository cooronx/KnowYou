# 若接口必须走本机代理（Node fetch 不自动读系统代理），启动时用：
#   NODE_USE_ENV_PROXY=1 npm run dev   （配合 HTTPS_PROXY / ALL_PROXY）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# Postgres：本地用 docker compose up -d 起库，凭据与 docker-compose.yml 一致
DATABASE_URL=postgresql://knowyou:knowyou@localhost:5432/knowyou?schema=public
